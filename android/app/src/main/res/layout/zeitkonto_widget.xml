<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:padding="16dp"
    android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="48dp"
        android:text="Zeitkonto" android:textColor="#FFFFFF" android:textSize="23sp" android:textStyle="bold"
        android:gravity="center_vertical" android:contentDescription="@string/widget_open" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_subtitle" android:textColor="#E0F0FF" android:textSize="14sp"
        android:layout_marginBottom="12dp" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/widget_record" android:layout_width="match_parent" android:layout_height="52dp"
        android:background="@drawable/widget_action_background" android:gravity="center"
        android:text="@string/widget_record" android:textColor="#064C88" android:textSize="16sp" android:textStyle="bold"
        android:paddingHorizontal="8dp" android:maxLines="2" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:layout_marginTop="8dp">
        <TextView android:id="@+id/widget_calendar" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="@drawable/widget_action_background" android:gravity="center" android:layout_marginEnd="4dp"
            android:text="@string/widget_calendar" android:textColor="#064C88" android:textSize="14sp" android:textStyle="bold"
            android:paddingHorizontal="6dp" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/widget_balance" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="@drawable/widget_action_background" android:gravity="center" android:layout_marginStart="4dp"
            android:text="@string/widget_balance" android:textColor="#064C88" android:textSize="14sp" android:textStyle="bold"
            android:paddingHorizontal="6dp" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
